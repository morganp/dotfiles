# .screenrc Add the line below to your screenrc
#source $HOME/dotfiles/config/screen/dot-screenrc
# or symlink with stow
#   cd $HOME/dotfiles/config
#   stow screen --dotfiles -t ~/

# Color table:
# 0 Black             .    leave color unchanged
# 1 Red               b    blue
# 2 Green             c    cyan
# 3 Brown / yellow    d    default color
# 4 Blue              g    green           b    bold
# 5 Purple            k    blacK           B    blinking
# 6 Cyan              m    magenta         d    dim
# 7 White             r    red             r    reverse
# 8 unused/illegal    w    white           s    standout
# 9 transparent       y    yellow          u    underline

#Set default shell from ENV variable $SHELL
#shell -bash
#defshell -bash
## Create initial Named screens
#screen -t "Name 1"
#screen -t "Two"
# Keep the window/stats row above a shortcut guide for new Screen users.
# %H expands to the hostname of the machine running Screen.
caption always
caption string '%{= kW}%-Lw%{= KW}%50>%n%f* %t%{= kW}%+Lw%< %{= kG}%-=%H  %D %d %M %Y %c:%s%{-}'

hardstatus alwayslastline
hardstatus string '%{= kW}%=%{= KW}Prefix: Ctrl-a  |  c: create  |  A: rename  |  n/p: next/previous  |  d: detach%=%{-}'

defscrollback 10000
vbell off

# Advertise Screen's 256-colour virtual terminal to applications such as
# Codex. The default `screen` entry exposes only eight colours.
term screen-256color
truecolor on

termcapinfo xterm* ti@:te@
termcapinfo linux* ti@:te@
termcapinfo screen* ti@:te@
