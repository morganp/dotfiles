if [ -n "${ZSH_DEBUGRC+1}" ]; then
  zmodload zsh/zprof
fi

# Homebrew is optional. Detect common installations without emitting errors on
# machines where it is unavailable.
if (( $+commands[brew] )); then
  eval "$(brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# API keys live in ~/.config/codex/env (chmod 600).
# Put lines like: export OPENAI_API_KEY=...
if [[ -f "$HOME/.config/codex/env" ]]; then
  source "$HOME/.config/codex/env"
fi

# Oh My Zsh and its bundled git plugin.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(
  git
)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
  DOTFILES_OMZ_LOADED=1
fi

# Spaceship settings from Scott Spence's optimized Zsh setup:
# https://scottspence.com/posts/speeding-up-my-zsh-shell
SPACESHIP_PROMPT_ASYNC=true
SPACESHIP_PROMPT_ADD_NEWLINE=true
SPACESHIP_CHAR_SYMBOL="⚡"
SPACESHIP_PROMPT_ORDER=(
  time
  user
  dir
  git
  line_sep
  char
)
if [[ -n ${HOMEBREW_PREFIX-} && -r "$HOMEBREW_PREFIX/opt/spaceship/spaceship.zsh" ]]; then
  source "$HOMEBREW_PREFIX/opt/spaceship/spaceship.zsh"
fi

source "$HOME/dotfiles/config/shell/dot-zshrc"

# Third-party Zsh plugins are installed by Homebrew. Syntax highlighting must
# load last because it wraps ZLE widgets installed by earlier plugins.
if [[ -n ${HOMEBREW_PREFIX-} ]]; then
  [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Profile with: time ZSH_DEBUGRC=1 zsh -i -c exit
if [ -n "${ZSH_DEBUGRC+1}" ]; then
  zprof
fi
