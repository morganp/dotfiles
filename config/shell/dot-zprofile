if [ -n "${ZSH_DEBUGRC+1}" ]; then
  zmodload zsh/zprof
fi

# Homebrew is optional. Detect common installations without emitting errors on
# machines where it is unavailable.
if (( $+commands[brew] )); then
  eval "$(brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# API keys live in ~/.config/codex/env (chmod 600).
# Put lines like: export OPENAI_API_KEY=...
if [[ -f "$HOME/.config/codex/env" ]]; then
  source "$HOME/.config/codex/env"
fi

# Completion functions stored in the dotfiles repository must be added to
# fpath before Oh My Zsh runs compinit. The Codex completion is generated from
# the installed CLI, rather than evaluated during every shell startup.
# Regenerate it after upgrading Codex with:
#   codex completion zsh > "$HOME/dotfiles/config/shell/completions/_codex"
fpath=("$HOME/dotfiles/config/shell/completions" $fpath)

# Oh My Zsh and its bundled git plugin.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(
  git
)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
  DOTFILES_OMZ_LOADED=1
fi

# The prompt is deliberately not initialised here. macOS /etc/zshrc sets
# PS1 and is read after ~/.zprofile, so anything set at this stage is
# overwritten in login shells. See config/shell/dot-zprompt, sourced from
# ~/.zshrc.

source "$HOME/dotfiles/config/shell/dot-zshrc"

# Third-party Zsh plugins are installed by Homebrew. Syntax highlighting must
# load last because it wraps ZLE widgets installed by earlier plugins.
if [[ -n ${HOMEBREW_PREFIX-} ]]; then
  [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
    source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
    source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Profile with: time ZSH_DEBUGRC=1 zsh -i -c exit
if [ -n "${ZSH_DEBUGRC+1}" ]; then
  zprof
fi

# Start or attach to the shared tmux session for interactive terminals. TMUX is
# set inside tmux, which prevents new panes from creating nested sessions.
if [[ -o interactive && -z "${TMUX:-}" && -t 1 ]] && (( $+commands[tmux] )); then
  exec tmux new-session -A -s main
fi
